# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Cloud Storage
GCS_RAW_BUCKET=your-raw-data-bucket

# BigQuery
BQ_RAW_DATASET=raw
BQ_DBT_DATASET=dbt_prod

# dbt (models land in the staging / mart / snapshots datasets;
# BQ_DBT_DATASET is only the profile's default dataset)
DBT_TARGET=prod